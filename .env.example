# Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/schoolflow
MONGODB_REPLICA_SET=rs0

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_this_in_production
JWT_REFRESH_SECRET=change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=sk_test_...  # same as SECRET_KEY for HMAC

# SMS (Termii)
SMS_API_KEY=termii_api_key
SMS_SENDER_ID=SchoolFlow

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=pass
SMTP_FROM=noreply@schoolflow.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloud
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret

# Monitoring
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=1
AUTH_RATE_LIMIT_MAX=5

# Idempotency
IDEMPOTENCY_TTL=86400

# CORS
CORS_ORIGIN=http://localhost:3000

# Default admin (use only in dev; for production, use separate setup)
ADMIN_EMAIL=admin@schoolflow.com
